# HEALTH TIPS
# ==========================================

def show_tips():

    result_box.delete("1.0", tk.END)

    text = entry.get().lower().strip()

    if not text:

        result_box.insert(
            tk.END,
            "GENERAL HEALTH TIPS\n"
            "────────────────────────\n\n"
            "• Stay hydrated.\n\n"
            "• Eat a balanced diet.\n\n"
            "• Maintain a regular sleep schedule.\n\n"
            "• Stay physically active when appropriate.\n\n"
            "• Maintain good personal hygiene.\n\n"
            "• Seek professional medical advice when needed."
        )

        return

    symptoms = extract_symptoms(text)

    tips = []

    for disease, data in health_data.items():

        for symptom in symptoms:

            if symptom in data["symptoms"]:

                if data["tip"] not in tips:
                    tips.append(data["tip"])

    if tips:

        result_box.insert(
            tk.END,
            "HEALTH TIPS\n"
            "────────────────────────\n\n"
        )

        for tip in tips[:5]:

            result_box.insert(
                tk.END,
                "• " + tip + "\n\n"
            )

        result_box.insert(
            tk.END,
            "These are general educational suggestions."
        )

    else:

        result_box.insert(
            tk.END,
            "No specific tip was found.\n\n"
            "Try entering a symptom first."
        )


# ==========================================
# CATEGORIES
# ==========================================

def show_categories():

    result_box.delete("1.0", tk.END)

    categories = {}

    for disease, data in health_data.items():

        category = data["category"]

        if category not in categories:
            categories[category] = []

        categories[category].append(disease)

    result_box.insert(
        tk.END,
        "HEALTH CATEGORIES\n"
        "────────────────────────\n\n"
    )

    for category, diseases in categories.items():

        result_box.insert(
            tk.END,
            category + "\n"
        )

        for disease in diseases:

            result_box.insert(
                tk.END,
                "  • " + disease + "\n"
            )

        result_box.insert(
            tk.END,
            "\n"
        )


