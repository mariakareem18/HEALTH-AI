    "joint ache": "joint pain",
    "joint aches": "joint pain",
    "sore joints": "joint tenderness",
    "runny nose": "runny nose"
}


# ==========================================
# FIND SYMPTOMS IN NATURAL LANGUAGE
# ==========================================

def extract_symptoms(text):

    text = text.lower()

    found = []

    # Check aliases first
    for phrase, symptom in aliases.items():

        if phrase in text and symptom not in found:
            found.append(symptom)

    # Check database symptoms
    all_symptoms = set()

    for data in health_data.values():

        for symptom in data["symptoms"]:
            all_symptoms.add(symptom)

    # Longer phrases first
    sorted_symptoms = sorted(
        all_symptoms,
        key=len,
        reverse=True
    )

    for symptom in sorted_symptoms:

        if symptom in text and symptom not in found:
            found.append(symptom)

    return found


# ==========================================
# ANALYZE
# ==========================================

def analyze_symptoms():

    text = entry.get().lower().strip()

    result_box.delete("1.0", tk.END)

    if not text:

        result_box.insert(
            tk.END,
            "Please enter your symptoms.\n\n"
            "Example:\n"
            "I have a headache and fever."
        )

        return

    emergency_words = [
        "severe chest pain",
        "severe difficulty breathing",
        "unconscious",
        "unconsciousness",
        "fainting",
        "severe bleeding"
    ]

    for word in emergency_words:

        if word in text:

            result_box.insert(
                tk.END,
                "URGENT MEDICAL ATTENTION\n\n"
                "Your input contains a symptom that may "
                "require immediate professional medical care.\n\n"
                "Please seek urgent medical attention.\n\n"
                "Do not use this app for emergency diagnosis."
            )

            return

    symptoms = extract_symptoms(text)

    if not symptoms:

        result_box.insert(
            tk.END,
            "I couldn't identify a supported symptom.\n\n"
            "Try something like:\n"
            "headache and fever\n"
            "or\n"
            "I have back pain and stiffness."
        )

        return

    results = []

    for disease, data in health_data.items():

        matched = []

        for symptom in symptoms:

            if symptom in data["symptoms"]:
                matched.append(symptom)

        if matched:

            percentage = round(
                (len(matched) / len(symptoms)) * 100
            )

            results.append(
                (
                    disease,
                    data["category"],
                    matched,
                    percentage,
                    data["info"],
                    data["tip"]
                )
            )

    results.sort(
        key=lambda x: x[3],
        reverse=True
    )

    result_box.insert(
        tk.END,
        "POSSIBLE MATCHES\n"
    )

    result_box.insert(
        tk.END,
        "────────────────────────\n\n"
    )

    result_box.insert(
        tk.END,
        "Symptoms detected: "
        + ", ".join(symptoms)
        + "\n\n"
    )

    if results:

        for disease, category, matched, percentage, info, tip in results[:6]:

            result_box.insert(
                tk.END,
                disease + "\n"
            )

            result_box.insert(
                tk.END,
                "Category: "
                + category
                + "\n"
            )

            result_box.insert(
                tk.END,
                "Matched symptoms: "
                + ", ".join(matched)
                + "\n"
            )

            result_box.insert(
                tk.END,
                "Match: "
                + str(percentage)
                + "%\n"
            )

            result_box.insert(
                tk.END,
                "Information: "
                + info
                + "\n"
            )

            result_box.insert(
                tk.END,
                "Tip: "
                + tip
                + "\n\n"
            )

        result_box.insert(
            tk.END,
            "Note: These are educational symptom matches, "
            "not a medical diagnosis."
        )

    else:

        result_box.insert(
            tk.END,
            "No matching condition was found."
        )


